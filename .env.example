# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/p91carcare
PGHOST=localhost
PGPORT=5432
PGDATABASE=p91carcare
PGUSER=your_username
PGPASSWORD=your_password

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Alternative environment variable names
RAZORPAY_TEST_KEY_ID=rzp_test_your_key_id
RAZORPAY_TEST_KEY_SECRET=your_razorpay_test_key_secret

# Secret from the Razorpay dashboard -> Webhooks settings.
# REQUIRED: /api/razorpay-webhook fails CLOSED (HTTP 503) when this is unset. Verification is
# never skipped — skipping it would let anyone forge a payment event.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# n8n booking integration -> ERPNext
# Production webhook URL for workflow "Appointmnet Booking P91 CC" (id: UvrwB78oldxJotbH).
# Must be the /webhook/ PRODUCTION path — never /webhook-test/.
# When unset, ERP sync is disabled and surfaces as a retryable failure; it is never silently
# ignored, and there is no hardcoded production fallback in the application code.
N8N_BOOKING_WEBHOOK_URL=https://your-n8n-host/webhook/your-webhook-path

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
# Alternative environment variable names
META_WHATSAPP_TOKEN=your_whatsapp_cloud_api_access_token
META_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=P91 Car Care <noreply@p91carcare.com>
# Alternative environment variable names
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Alternative Email Service (SendGrid)
# SENDGRID_API_KEY=your_sendgrid_api_key
# SENDGRID_FROM_EMAIL=noreply@p91carcare.com

# Meta (Facebook/Instagram) Pixel
#
# Served to the browser at runtime by GET /api/public-config, NOT inlined at build time.
# Vite would bake a VITE_* value in during `npm run build`, and the Dockerfile passes no
# build arguments — so a build-time variable is always undefined inside the container and
# the pixel silently never loads. Setting this and restarting is enough to turn tracking
# on; no rebuild, no redeploy.
#
# The Pixel ID is an identifier, not a secret: it is visible in the page source of every
# site that uses one. Leave it unset and no pixel loads at all, which is a valid state.
#
# If a Conversions API token is ever added it is a REAL secret — it must stay server-side
# and must never be added to /api/public-config.
META_PIXEL_ID=

# Application Configuration
NODE_ENV=development
PORT=5000

# Optional: Google Maps API (for enhanced location features)
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Optional: File Upload Configuration (if implementing image uploads)
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Security Headers (for production)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
