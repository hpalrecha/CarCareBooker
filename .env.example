# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/p91carcare
PGHOST=localhost
PGPORT=5432
PGDATABASE=p91carcare
PGUSER=your_username
PGPASSWORD=your_password

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Alternative environment variable names
RAZORPAY_TEST_KEY_ID=rzp_test_your_key_id
RAZORPAY_TEST_KEY_SECRET=your_razorpay_test_key_secret

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
# Alternative environment variable names
META_WHATSAPP_TOKEN=your_whatsapp_cloud_api_access_token
META_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=P91 Car Care <noreply@p91carcare.com>
# Alternative environment variable names
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Alternative Email Service (SendGrid)
# SENDGRID_API_KEY=your_sendgrid_api_key
# SENDGRID_FROM_EMAIL=noreply@p91carcare.com

# Application Configuration
NODE_ENV=development
PORT=5000

# Optional: Google Maps API (for enhanced location features)
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Optional: File Upload Configuration (if implementing image uploads)
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Security Headers (for production)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
